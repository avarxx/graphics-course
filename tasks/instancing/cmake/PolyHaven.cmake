# Downloads Poly Haven assets at configure time using the public API
# (https://api.polyhaven.com). Assets are cached in the build folder, so
# nothing large is committed into the repository. If the network is not
# available, a warning is printed and the application falls back to
# procedural placeholders at runtime.

option(GRAPHICS_COURSE_FETCH_ASSETS "Download Poly Haven assets during configuration" ON)

set(POLYHAVEN_USER_AGENT "graphics-course-hw/1.0")

function(_polyhaven_download url dst out_ok)
  if(EXISTS "${dst}")
    file(SIZE "${dst}" _size)
    if(_size GREATER 0)
      set(${out_ok} TRUE PARENT_SCOPE)
      return()
    endif()
  endif()
  get_filename_component(_dir "${dst}" DIRECTORY)
  file(MAKE_DIRECTORY "${_dir}")
  message(STATUS "Poly Haven: downloading ${url}")
  file(DOWNLOAD "${url}" "${dst}.part"
    STATUS _status
    TIMEOUT 120
    HTTPHEADER "User-Agent: ${POLYHAVEN_USER_AGENT}")
  list(GET _status 0 _code)
  if(_code EQUAL 0)
    file(RENAME "${dst}.part" "${dst}")
    set(${out_ok} TRUE PARENT_SCOPE)
  else()
    file(REMOVE "${dst}.part")
    list(GET _status 1 _msg)
    message(WARNING "Poly Haven: failed to download ${url}: ${_msg}")
    set(${out_ok} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(_polyhaven_info asset dest_dir out_json)
  set(_json_path "${dest_dir}/.info/${asset}.json")
  _polyhaven_download("https://api.polyhaven.com/files/${asset}" "${_json_path}" _ok)
  if(NOT _ok)
    set(${out_json} "" PARENT_SCOPE)
    return()
  endif()
  file(READ "${_json_path}" _json)
  set(${out_json} "${_json}" PARENT_SCOPE)
endfunction()

# polyhaven_fetch_texture(<asset> <dest_dir> <map>...)
# Saves every map as <dest_dir>/<asset>/<map>.<jpg|png>, e.g. sand_03/Diffuse.jpg
function(polyhaven_fetch_texture asset dest_dir)
  if(NOT GRAPHICS_COURSE_FETCH_ASSETS)
    return()
  endif()
  set(_stamp "${dest_dir}/${asset}/.complete")
  if(EXISTS "${_stamp}")
    return()
  endif()

  _polyhaven_info(${asset} "${dest_dir}" _json)
  if(_json STREQUAL "")
    return()
  endif()

  set(_all_ok TRUE)
  foreach(_map ${ARGN})
    set(_url "")
    foreach(_fmt jpg png)
      string(JSON _candidate ERROR_VARIABLE _err GET "${_json}" "${_map}" "1k" "${_fmt}" "url")
      if(_err STREQUAL "NOTFOUND")
        set(_url "${_candidate}")
        set(_ext "${_fmt}")
        break()
      endif()
    endforeach()
    if(_url STREQUAL "")
      message(WARNING "Poly Haven: asset ${asset} has no 1k map '${_map}'")
      set(_all_ok FALSE)
      continue()
    endif()
    _polyhaven_download("${_url}" "${dest_dir}/${asset}/${_map}.${_ext}" _ok)
    if(NOT _ok)
      set(_all_ok FALSE)
    endif()
  endforeach()

  if(_all_ok)
    file(WRITE "${_stamp}" "")
  endif()
endfunction()

# polyhaven_fetch_model(<asset> <dest_dir>)
# Saves the glTF as <dest_dir>/<asset>/<asset>.gltf together with all of its dependencies.
function(polyhaven_fetch_model asset dest_dir)
  if(NOT GRAPHICS_COURSE_FETCH_ASSETS)
    return()
  endif()
  set(_stamp "${dest_dir}/${asset}/.complete")
  if(EXISTS "${_stamp}")
    return()
  endif()

  _polyhaven_info(${asset} "${dest_dir}" _json)
  if(_json STREQUAL "")
    return()
  endif()

  string(JSON _gltf ERROR_VARIABLE _err GET "${_json}" "gltf" "1k" "gltf")
  if(NOT _err STREQUAL "NOTFOUND")
    message(WARNING "Poly Haven: asset ${asset} has no 1k glTF")
    return()
  endif()

  set(_all_ok TRUE)
  string(JSON _url GET "${_gltf}" "url")
  _polyhaven_download("${_url}" "${dest_dir}/${asset}/${asset}.gltf" _ok)
  if(NOT _ok)
    set(_all_ok FALSE)
  endif()

  string(JSON _includes ERROR_VARIABLE _err GET "${_gltf}" "include")
  if(_err STREQUAL "NOTFOUND")
    string(JSON _count LENGTH "${_includes}")
    if(_count GREATER 0)
      math(EXPR _last "${_count} - 1")
      foreach(_i RANGE ${_last})
        string(JSON _path MEMBER "${_includes}" ${_i})
        string(JSON _inc_url GET "${_includes}" "${_path}" "url")
        _polyhaven_download("${_inc_url}" "${dest_dir}/${asset}/${_path}" _ok)
        if(NOT _ok)
          set(_all_ok FALSE)
        endif()
      endforeach()
    endif()
  endif()

  if(_all_ok)
    file(WRITE "${_stamp}" "")
  endif()
endfunction()
